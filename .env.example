# Commissioner sign-in (placeholder until email/OAuth sign-in exists).
COMMISSIONER_PASSCODE=
# 32+ random characters, e.g. openssl rand -hex 32
SESSION_SECRET=
# Production database (Turso). Omit locally: data/league.db is used.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional. A long random secret that turns on /api/auto-scoring, which the weekly auto-scorer uses to save an
# episode's scoring as progress for the commissioner to review. It can never publish. Leave unset to keep it off.
LEAGUE_SCORING_TOKEN=
